{
  "folium": 1,
  "id": "ai-music-recommend",
  "name": "AI 推荐音乐",
  "version": "1.5.0",
  "author": "YaoCh",
  "description": "记录你平时的听歌喜好，用 OpenAI 兼容接口让 AI 推荐新歌，并自动在音源里搜索匹配成可播放的曲目；联动官方「听歌档案」与你网易云账号的歌单（只读），同名歌优先推你常听的版本；「推荐电台」接管队列连播、关闭时恢复原歌单。",
  "main": "main.cjs",
  "client": "client.mjs",
  "preview": "preview.png",
  "permissions": [
    "filesystem.data",
    "playback.control",
    "playback.queue",
    "platform.netease.read"
  ],
  "folia": ">=0.7.22 <0.8.0",
  "experimental": [
    "platform.raw"
  ]
}
